# ---------------------------------------------------------------------------
# Copie ce fichier en .env et colle tes cles. .env n'est jamais commite.
# ---------------------------------------------------------------------------

# HeyGen — avatar clone + voix clonee
# HeyGen > Espace developpeur > API key
HEYGEN_API_KEY=

# ID de ton avatar et de ta voix.
# Pour les lister : node scripts/heygen.mjs --avatars
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Vitesse de diction (1.0 = normal). 1.05 donne un rythme un peu plus reel.
HEYGEN_VOICE_SPEED=1.0

# Fond de la video avatar.
#   #131222  -> le violet profond de la marque (defaut)
#   none     -> garder le decor du tournage
#   https:// -> une image de fond
# Le remplacement ne marche que si l'avatar a ete filme sur un mur uni ou un
# fond vert : c'est ce detourage que HeyGen utilise.
HEYGEN_BACKGROUND=#131222

# ---------------------------------------------------------------------------
# Optionnel
# ---------------------------------------------------------------------------

# Chromium local si la machine ne peut pas telecharger celui de Remotion.
# REMOTION_BROWSER_EXECUTABLE=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell

# ffmpeg si absent du PATH (utilise pour couper les blancs).
# FFMPEG_PATH=/usr/bin/ffmpeg
